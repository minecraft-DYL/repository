<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OreUI.WinUI">

    <!-- ============================ OreTextBox ============================ -->
    <!--
        WinUI TextBox 模板契约：必须提供名为 ContentElement 的 ScrollViewer 与
        PlaceholderTextContentPresenter，否则文本无法渲染 / 占位符不显示。
        OreUI 的凹陷感 = 2px 黑边 + 顶部 4px 内阴影（inset 0 4px #242425）。
    -->
    <Style TargetType="local:OreTextBox">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource OreUIFontSizeBody}" />
        <Setter Property="MinHeight" Value="{ThemeResource OreUITextFieldMinHeight}" />
        <Setter Property="Padding" Value="10,10,11,10" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="SelectionHighlightColor" Value="#6CC349" />
        <!-- 同上：OreUI 不用系统焦点矩形 -->
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreTextBox">
                    <Grid>
                        <Border
                            x:Name="OreFillBorder"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                        <Grid Margin="{TemplateBinding BorderThickness}" IsHitTestVisible="False">
                            <Border
                                x:Name="OreInsetTopShadow"
                                Height="4"
                                VerticalAlignment="Top"
                                Background="#242425" />
                        </Grid>
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto" />
                        <ContentPresenter
                            x:Name="PlaceholderTextContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding PlaceholderText}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== OreButtonGroup ========================== -->
    <Style TargetType="local:OreButtonGroup">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreButtonGroup">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== OreTextField =========================== -->
    <Style TargetType="local:OreTextField">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreTextField">
                    <Grid>
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
