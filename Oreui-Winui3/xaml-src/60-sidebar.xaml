<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OreUI.WinUI">

    <!-- ========================== OreSidebarItem ========================== -->
    <Style TargetType="local:OreSidebarItem">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreSidebarItem">
                    <Border
                        x:Name="OreItemBorder"
                        Height="40"
                        Padding="10,0,0,0"
                        Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="OreItemIcon"
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#FFFFFF"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="OreItemText"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFFFFF"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ OreSidebar ============================ -->
    <!--
        窄屏：遮罩 + 左侧滑出面板（600ms cubic 缓动，对应 sidebar-transition）。
        宽屏（≥1200）：面板常驻、遮罩隐藏，对应 @media (min-width: 1200px)。
    -->
    <Style TargetType="local:OreSidebar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreSidebar">
                    <Grid>
                        <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border
                            x:Name="OreSidebarMask"
                            Background="#000000B3"
                            Visibility="Collapsed" />
                        <Grid
                            x:Name="OreSidebarPanel"
                            Width="238"
                            HorizontalAlignment="Left"
                            Background="#313233"
                            BorderBrush="#1E1E1F"
                            BorderThickness="0,0,2,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="OrePanelTransform" X="-240" />
                            </Grid.RenderTransform>
                            <!--
                                上游 oreui-scroll-view 是 overflow-y: hidden —— 侧边栏压根不显示滚动条。
                                用 Auto 会露出 WinUI 的原生滚动条，整条侧边栏立刻「很 WinUI」。
                                Hidden 仍支持滚轮滚动，只是不画滚动条。
                            -->
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Auto">
                                <StackPanel Margin="0,10">
                                    <TextBlock
                                        x:Name="OreSidebarTitle"
                                        Margin="0,6"
                                        FontFamily="{ThemeResource OreUIFontTitleFamily}"
                                        FontSize="20"
                                        Foreground="#FFFFFF"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        x:Name="OreSidebarDetail"
                                        Margin="0,0,0,24"
                                        FontSize="14"
                                        Foreground="#D0D1D4"
                                        TextAlignment="Center"
                                        Visibility="Collapsed" />
                                    <Border
                                        x:Name="OreSidebarDivider"
                                        Margin="0,0,0,6"
                                        BorderBrush="#313233"
                                        BorderThickness="0,2,0,2" />
                                    <StackPanel x:Name="OreSidebarItems" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
