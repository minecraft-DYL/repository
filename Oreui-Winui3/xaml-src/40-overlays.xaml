<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OreUI.WinUI">

    <!-- ============================ OrePopHost ============================ -->
    <!--
        上游 oreui-pop-area：
          bottom:40px; left:50%; transform:translateX(-50%);
          width:min(90%,500px); display:flex; flex-direction:column-reverse;
          align-items:center; overflow:hidden; pointer-events:none; z-index:100
        column-reverse + prepend 的合效果是「新消息出现在最下方、整叠往上长」，
        对应这里「垂直贴底 + 顺序追加」。
        保真度取舍：min(90%, 500px) 里的 90% 在 XAML 里没有等价的百分比宽度，
        只保留了 500px 上限（MaxWidth）。
    -->
    <Style TargetType="local:OrePopHost">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OrePopHost">
                    <Grid>
                        <StackPanel
                            x:Name="OrePopStack"
                            MaxWidth="500"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== OreLoadingMask ========================== -->
    <!--
        上游 oreui-loading-mask（layout/loading/style.css）：
          background-color:#48494A; 铺满视口; flex 居中; opacity 过渡 0.8s
          .spinner_img        { width:60px; height:60px }   -> Loading_white.gif（原图 144×144）
          .spinner_text       { color:#FFFFFF; font-size:24px }
          .spinner_img_error  { height:160px; padding:10px 0 } -> ErrorMessage.png（原图 160×160）
          .spinner_text_error { color:#C02D2D; font-size:20px; font-weight:bold; padding:10px 0;
                                -webkit-text-stroke:0.05em #FFFFFF }
        ⚠️ 这里**不能**用 ProgressRing：OreUI 的加载指示器是一张动画 GIF，
        用 WinUI 的转圈就是「一看就还是 WinUI3」的来源。Image 会自动播放 GIF。
        保真度取舍：.spinner_text_error 的白色文字描边（-webkit-text-stroke）没有直接等价物，
        只保留了红字加粗。
    -->
    <Style TargetType="local:OreLoadingMask">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreLoadingMask">
                    <Border x:Name="OreMaskBorder" Background="#48494A">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!-- oreui-loading-wrapper { flex-direction:column } -->
                            <Image
                                x:Name="OreSpinner"
                                Width="60"
                                Height="60"
                                Stretch="Uniform" />
                            <Image
                                x:Name="OreErrorImage"
                                Height="160"
                                Margin="0,10"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="OreLoadingText"
                                FontSize="24"
                                Foreground="#FFFFFF"
                                Text="加载中…" />
                            <TextBlock
                                x:Name="OreErrorText"
                                MaxWidth="420"
                                Margin="0,10"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#C02D2D"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= OreModal ============================= -->
    <!--
        逐条对齐上游 oreui.css：
          .overlay          { background-color:rgba(0,0,0,.7) }        -> 代码里刷 #000000B3
          modal_area        { border:2px solid #1E1E1F; min-width:320px;
                              max-width:min(600px,100vw); 居中 }
          modal             { background-color:#313233; color:#FFFFFF; text-align:center }
          modal_title_area  { background-color:#48494A; height:40px;
                              box-shadow: inset 2px 2px rgba(255,255,255,.2),
                                          inset -2px -2px rgba(255,255,255,.1);
                              font-size:18px }
          modal_title       { 居中; top calc(50% - 1px) }
          modal_close_btn   { right:4px; 垂直居中; width:32px; height:calc(100% - 8px);
                              hover/active { background-color:#58585A } }
          .modal_close_btn_img { width:20px; height:20px }             -> cross_white.png（原图 52×52）
          modal_content     { min-height:60px; max-height:min(450px,90vh-150px);
                              padding:10px; overflow-y:auto; scrollbar-width:none;
                              display:grid; align-items:center }
          modal_button_area { background-color:#48494A; padding:2px 0;
                              border-top:2px solid #5A5B5C; border-bottom:2px solid #333334 }
          modal_button_group{ width:calc(100% - 20px) }
          modal_button_list { display:flex; align-items:center }
          .modal_btn        { width:calc(100% - 10px) }

        ⚠️ 上游 CSS 里 modal_title_area **没有** font-family —— 弹窗标题不是 Minecraft Ten，
        而是继承页面正文字体（按钮才用 NotoSans Bold）。别给它套 mc-ten。
        保真度取舍：max-height 里的 90vh-150px 方差在 XAML 里按固定 450px 处理。
    -->
    <Style TargetType="local:OreModal">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreModal">
                    <Grid>
                        <Border x:Name="OreModalOverlay" Background="#000000B3" />
                        <Border
                            x:Name="OreModalPanel"
                            MinWidth="320"
                            MaxWidth="600"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#313233"
                            BorderBrush="#1E1E1F"
                            BorderThickness="2">
                            <StackPanel>
                                <Border
                                    x:Name="OreTitleArea"
                                    Height="40"
                                    Background="#48494A">
                                    <Grid>
                                        <!--
                                            inset 阴影没有 XAML 等价物，拆成两条内描边。
                                            CSS 里 inset 2px 2px 写在前面 = 画在上层，
                                            而 XAML 是「越靠后越在上层」 => 高光必须放最后。
                                        -->
                                        <Border
                                            BorderBrush="#FFFFFF1A"
                                            BorderThickness="0,0,2,2"
                                            IsHitTestVisible="False" />
                                        <Border
                                            BorderBrush="#FFFFFF33"
                                            BorderThickness="2,2,0,0"
                                            IsHitTestVisible="False" />
                                        <TextBlock
                                            x:Name="OreModalTitleText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="#FFFFFF" />
                                        <Grid>
                                            <!--
                                                关闭键：上游是图片不是字体图标。
                                                再叠一层 Image 而不是塞进 Button.Content，
                                                是为了让具名部件留在模板命名域里（GetTemplateChild 更稳）。
                                                Button 本体宽 32 且右边距 4，中心距右 20，
                                                所以 20px 的图右边距取 4 + (32-20)/2 = 10。
                                            -->
                                            <Button
                                                x:Name="OreModalCloseIcon"
                                                Width="32"
                                                Margin="0,4,4,4"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid x:Name="OreCloseRoot" Background="{TemplateBinding Background}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />
                                                                    <VisualState x:Name="PointerOver">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OreCloseRoot" Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#58585A" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OreCloseRoot" Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#58585A" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled" />
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Content="{TemplateBinding Content}" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Image
                                                x:Name="OreCloseGlyph"
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ScrollViewer
                                    x:Name="OreContentArea"
                                    MinHeight="60"
                                    MaxHeight="450"
                                    Padding="10"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Auto">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </ScrollViewer>
                                <Border
                                    x:Name="OreButtonArea"
                                    Background="#48494A"
                                    BorderBrush="#5A5B5C"
                                    BorderThickness="0,2,0,0">
                                    <Border
                                        Padding="0,2"
                                        BorderBrush="#333334"
                                        BorderThickness="0,0,0,2">
                                        <!-- modal_button_group: width calc(100% - 20px) -->
                                        <Grid Margin="10,0">
                                            <!-- modal_button_list + .modal_btn width calc(100% - 10px) = 两个等宽按钮 -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <local:OreButton
                                                x:Name="OrePrimaryButton"
                                                Grid.Column="0"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Stretch"
                                                Content="确定"
                                                Size="ExtraSmall"
                                                Status="Green" />
                                            <local:OreButton
                                                x:Name="OreCloseButton"
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Content="取消"
                                                Size="ExtraSmall" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
