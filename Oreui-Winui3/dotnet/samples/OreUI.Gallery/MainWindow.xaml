<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OreUI.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oreui="using:OreUI.WinUI"
    mc:Ignorable="d">

    <Grid Background="#1E1E1F">
        <Grid x:Name="ContentRoot">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="0,0,20,40">
                    <oreui:OrePageTitle Content="OreUI 组件总览" />

                    <!-- ==================== 按钮 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="按钮 OreButton" />
                            <oreui:OreButtonGroup>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <oreui:OreButton Content="默认 Normal" Size="Small" Status="Normal" />
                                        <oreui:OreButton Content="主色 Green" Size="Small" Status="Green" />
                                        <oreui:OreButton Content="危险 Red" Size="Small" Status="Red" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <oreui:OreButton Content="禁用 Disabled" Size="Small" Status="Disabled" />
                                        <oreui:OreButton Content="带图标" IconGlyph="&#xE768;" Size="Small" />
                                        <oreui:OreButton Content="右侧图标" IconGlyph="&#xE72A;" IconPosition="Right" Size="Small" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <oreui:OreButton
                                            x:Name="CountdownButton"
                                            Content="倒计时 10s"
                                            Countdown="10"
                                            Size="Small"
                                            Status="Green" />
                                        <oreui:OreButton
                                            Content="侧边栏样式"
                                            Size="Small"
                                            Type="Sidebar"
                                            Width="140" />
                                        <oreui:OreButton Content="超大 Large" Size="Large" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <oreui:OreButton Content="最小 XS" Size="ExtraSmall" />
                                        <oreui:OreButton Content="小 SM" Size="Small" />
                                        <oreui:OreButton Content="中 MD" Size="Middle" />
                                    </StackPanel>
                                </StackPanel>
                            </oreui:OreButtonGroup>
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />

                    <!-- ==================== 选择控件 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="复选框 / 开关 / 滑块" />

                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <oreui:OreCheckBox Content="未选中" />
                                <oreui:OreCheckBox Content="已选中" IsChecked="True" />
                                <oreui:OreCheckBox Content="禁用" IsEnabled="False" />
                                <oreui:OreCheckBox Content="禁用选中" IsChecked="True" IsEnabled="False" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <oreui:OreToggleSwitch Margin="0,0,20,0" IsOn="True" />
                                <oreui:OreToggleSwitch Margin="0,0,20,0" IsOn="False" />
                                <oreui:OreToggleSwitch Margin="0,0,20,0" IsEnabled="False" IsOn="True" />
                            </StackPanel>

                            <StackPanel Width="460" HorizontalAlignment="Left">
                                <oreui:OreSlider
                                    x:Name="DemoSlider"
                                    Margin="8,0"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="45" />
                                <oreui:OreSlider
                                    Margin="8,0"
                                    Maximum="100"
                                    Minimum="0"
                                    Segments="5"
                                    StepFrequency="25"
                                    Value="50" />
                                <oreui:OreSlider
                                    Margin="8,0"
                                    IsEnabled="False"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="70" />
                            </StackPanel>
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />

                    <!-- ==================== 输入 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="文本框 OreTextBox" />
                            <oreui:OreTextField Width="420">
                                <StackPanel>
                                    <oreui:OreTextBox PlaceholderText="请输入内容…" />
                                    <oreui:OreTextBox
                                        Margin="0,8,0,0"
                                        PlaceholderText="只读"
                                        IsReadOnly="True"
                                        Text="只读内容" />
                                    <oreui:OreTextBox
                                        Margin="0,8,0,0"
                                        PlaceholderText="禁用"
                                        IsEnabled="False" />
                                    <oreui:OreTextBox
                                        Margin="0,8,0,0"
                                        AcceptsReturn="True"
                                        Height="80"
                                        PlaceholderText="多行输入…"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </oreui:OreTextField>
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />

                    <!-- ==================== 标签 / 徽标 / 分割线 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="标签 / 徽标 / 分割线" />
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <oreui:OreTag Content="中性" />
                                <oreui:OreTag Content="绿色" Accent="Green" />
                                <oreui:OreTag Content="蓝色" Accent="Blue" />
                                <oreui:OreTag Content="黄色" Accent="Yellow" />
                                <oreui:OreTag Content="红色" Accent="Red" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <oreui:OreBadge />
                                <oreui:OreBadge Accent="Green" />
                                <oreui:OreBadge Accent="Blue" />
                                <oreui:OreBadge Accent="Yellow" />
                                <oreui:OreBadge Accent="Red" />
                            </StackPanel>
                            <oreui:OreDivider />
                            <oreui:OreLine />
                            <oreui:OreDividerBox />
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />

                    <!-- ==================== 消息条 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="消息条 OreBanner" />
                            <oreui:OreBanner Content="中性提示：这是一条普通消息。" />
                            <oreui:OreBanner BannerType="Information" Content="信息提示：这是一条蓝色信息消息。" />
                            <oreui:OreBanner BannerType="Important" Content="重要提示：这是一条黄色重要消息！" />
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />

                    <!-- ==================== 链接块 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="链接块 OreShowBlock（悬停有高光扫过）" />
                            <oreui:OreShowBlock
                                Click="OnShowBlockClick"
                                Description="点击后在底部弹出一条气泡提示"
                                Glyph="&#xE8A5;"
                                Title="查看 OreUI 上游仓库" />
                            <oreui:OreShowBlock
                                Click="OnShowBlockClick"
                                Description="带描述的第二块"
                                Title="无图标链接块" />
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />

                    <!-- ==================== 交互演示 ==================== -->
                    <oreui:OreMainBlock>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                Text="气泡 / 弹窗 / 加载遮罩" />
                            <StackPanel Orientation="Horizontal">
                                <oreui:OreButton
                                    Click="OnPopClick"
                                    Content="弹出气泡"
                                    Size="Small"
                                    Status="Green" />
                                <oreui:OreButton
                                    Click="OnModalClick"
                                    Content="打开弹窗"
                                    Size="Small" />
                                <oreui:OreButton
                                    Click="OnDialogClick"
                                    Content="静态 ShowAsync"
                                    Size="Small" />
                                <oreui:OreButton
                                    Click="OnLoadingClick"
                                    Content="加载遮罩 2s"
                                    Size="Small"
                                    Status="Red" />
                            </StackPanel>
                        </StackPanel>
                    </oreui:OreMainBlock>

                    <oreui:OreMainBlockSpacing />
                    <oreui:OreMainDisplay>
                        <TextBlock
                            FontSize="12"
                            Foreground="#B1B2B5"
                            Text="OreUI.WinUI · 基于 https://github.com/Spectrollay-OreUI/OreUI (MIT) 的 WinUI 3 移植" />
                    </oreui:OreMainDisplay>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 侧边栏：宽屏常驻，窄屏遮罩滑出 -->
        <oreui:OreSidebar
            x:Name="Sidebar"
            Detail="WinUI 3 移植 · v1.0.0"
            IsOpen="True"
            Title="OreUI">
            <oreui:OreSidebar.Items>
                <oreui:OreSidebarItem Glyph="&#xE80F;" Text="总览" />
                <oreui:OreSidebarItem Glyph="&#xE8A5;" Text="按钮" />
                <oreui:OreSidebarItem Glyph="&#xE73E;" Text="选择控件" />
                <oreui:OreSidebarItem Glyph="&#xE70F;" Text="输入" />
                <oreui:OreSidebarItem Glyph="&#xE8EC;" Text="消息" />
            </oreui:OreSidebar.Items>
        </oreui:OreSidebar>

        <oreui:OrePopHost x:Name="PopHost" />

        <oreui:OreModal
            x:Name="DemoModal"
            Title="OreUI 弹窗"
            IsOpen="False">
            <StackPanel Width="360">
                <TextBlock
                    FontSize="16"
                    Text="这是一个 OreUI 模态弹窗。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="14"
                    Foreground="#B1B2B5"
                    Text="标题栏 / 内容区 / 按钮区三段配色与原版一致。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </oreui:OreModal>

        <oreui:OreLoadingMask
            x:Name="DemoLoading"
            IsLoading="False"
            Text="正在加载资源…" />
    </Grid>
</Window>
