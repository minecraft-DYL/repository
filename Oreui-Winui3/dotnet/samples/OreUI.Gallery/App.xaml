<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OreUI.Gallery.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    必须合并 XamlControlsResources（WinUI 3 的框架默认样式表）。
                    少了它，任何 WinUI 内置控件都拿不到默认样式：
                    OreLoadingMask 里的 ProgressRing 在第一次可见时会去查
                    框架资源，抛 “Cannot find a Resource with the Name/Key ...”，
                    而这个异常会被 WinUI 收成 STOWED_EXCEPTION(0xc000027b) 直接
                    fail-fast —— 表现就是「点出加载遮罩就崩」，且
                    Application.UnhandledException 都抓不到。

                    ⚠️ 早期这里曾经把它删掉过，理由是「非打包应用合并它会抛
                    String 无法赋给 Uri」。那个错其实来自 Themes/*.xaml 里
                    相对的 ResourceDictionary.Source="X.xaml"（已改为单一自包含
                    Generic.xaml），跟 XamlControlsResources 无关。别再删了。

                    字体也不在这里覆盖：OreUI.WinUI 的默认样式表已经用
                    ms-appx:///OreUI.WinUI/Assets/OreUI/Fonts/...#<内部family名>
                    指好了，连同字体文件一起由库分发到本应用输出目录。
                -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
