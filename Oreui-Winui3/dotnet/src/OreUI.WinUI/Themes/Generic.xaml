                              font-size:18px }
          modal_title       { 居中; top calc(50% - 1px) }
          modal_close_btn   { right:4px; 垂直居中; width:32px; height:calc(100% - 8px);
                              hover/active { background-color:#58585A } }
          .modal_close_btn_img { width:20px; height:20px }             -> cross_white.png（原图 52×52）
          modal_content     { min-height:60px; max-height:min(450px,90vh-150px);
                              padding:10px; overflow-y:auto; scrollbar-width:none;
                              display:grid; align-items:center }
          modal_button_area { background-color:#48494A; padding:2px 0;
                              border-top:2px solid #5A5B5C; border-bottom:2px solid #333334 }
          modal_button_group{ width:calc(100% - 20px) }
          modal_button_list { display:flex; align-items:center }
          .modal_btn        { width:calc(100% - 10px) }

        ⚠️ 上游 CSS 里 modal_title_area **没有** font-family —— 弹窗标题不是 Minecraft Ten，
        而是继承页面正文字体（按钮才用 NotoSans Bold）。别给它套 mc-ten。
        保真度取舍：max-height 里的 90vh-150px 方差在 XAML 里按固定 450px 处理。
    -->
    <Style TargetType="local:OreModal">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreModal">
                    <Grid>
                        <Border x:Name="OreModalOverlay" Background="#000000B3" />
                        <Border
                            x:Name="OreModalPanel"
                            MinWidth="320"
                            MaxWidth="600"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#313233"
                            BorderBrush="#1E1E1F"
                            BorderThickness="2">
                            <StackPanel>
                                <Border
                                    x:Name="OreTitleArea"
                                    Height="40"
                                    Background="#48494A">
                                    <Grid>
                                        <!--
                                            inset 阴影没有 XAML 等价物，拆成两条内描边。
                                            CSS 里 inset 2px 2px 写在前面 = 画在上层，
                                            而 XAML 是「越靠后越在上层」 => 高光必须放最后。
                                        -->
                                        <Border
                                            BorderBrush="#FFFFFF1A"
                                            BorderThickness="0,0,2,2"
                                            IsHitTestVisible="False" />
                                        <Border
                                            BorderBrush="#FFFFFF33"
                                            BorderThickness="2,2,0,0"
                                            IsHitTestVisible="False" />
                                        <TextBlock
                                            x:Name="OreModalTitleText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="#FFFFFF" />
                                        <Grid>
                                            <!--
                                                关闭键：上游是图片不是字体图标。
                                                再叠一层 Image 而不是塞进 Button.Content，
                                                是为了让具名部件留在模板命名域里（GetTemplateChild 更稳）。
                                                Button 本体宽 32 且右边距 4，中心距右 20，
                                                所以 20px 的图右边距取 4 + (32-20)/2 = 10。
                                            -->
                                            <Button
                                                x:Name="OreModalCloseIcon"
                                                Width="32"
                                                Margin="0,4,4,4"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid x:Name="OreCloseRoot" Background="{TemplateBinding Background}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />
                                                                    <VisualState x:Name="PointerOver">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OreCloseRoot" Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#58585A" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OreCloseRoot" Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#58585A" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled" />
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Content="{TemplateBinding Content}" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Image
                                                x:Name="OreCloseGlyph"
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ScrollViewer
                                    x:Name="OreContentArea"
                                    MinHeight="60"
                                    MaxHeight="450"
                                    Padding="10"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Auto">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </ScrollViewer>
                                <Border
                                    x:Name="OreButtonArea"
                                    Background="#48494A"
                                    BorderBrush="#5A5B5C"
                                    BorderThickness="0,2,0,0">
                                    <Border
                                        Padding="0,2"
                                        BorderBrush="#333334"
                                        BorderThickness="0,0,0,2">
                                        <!-- modal_button_group: width calc(100% - 20px) -->
                                        <Grid Margin="10,0">
                                            <!-- modal_button_list + .modal_btn width calc(100% - 10px) = 两个等宽按钮 -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <local:OreButton
                                                x:Name="OrePrimaryButton"
                                                Grid.Column="0"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Stretch"
                                                Content="确定"
                                                Size="ExtraSmall"
                                                Status="Green" />
                                            <local:OreButton
                                                x:Name="OreCloseButton"
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Content="取消"
                                                Size="ExtraSmall" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 50-inputs.xaml ==================== -->
    <!-- ============================ OreTextBox ============================ -->
    <!--
        WinUI TextBox 模板契约：必须提供名为 ContentElement 的 ScrollViewer 与
        PlaceholderTextContentPresenter，否则文本无法渲染 / 占位符不显示。
        OreUI 的凹陷感 = 2px 黑边 + 顶部 4px 内阴影（inset 0 4px #242425）。
    -->
    <Style TargetType="local:OreTextBox">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource OreUIFontSizeBody}" />
        <Setter Property="MinHeight" Value="{ThemeResource OreUITextFieldMinHeight}" />
        <Setter Property="Padding" Value="10,10,11,10" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="SelectionHighlightColor" Value="#6CC349" />
        <!-- 同上：OreUI 不用系统焦点矩形 -->
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreTextBox">
                    <Grid>
                        <Border
                            x:Name="OreFillBorder"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                        <Grid Margin="{TemplateBinding BorderThickness}" IsHitTestVisible="False">
                            <Border
                                x:Name="OreInsetTopShadow"
                                Height="4"
                                VerticalAlignment="Top"
                                Background="#242425" />
                        </Grid>
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto" />
                        <ContentPresenter
                            x:Name="PlaceholderTextContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding PlaceholderText}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== OreButtonGroup ========================== -->
    <Style TargetType="local:OreButtonGroup">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreButtonGroup">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== OreTextField =========================== -->
    <Style TargetType="local:OreTextField">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreTextField">
                    <Grid>
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 60-sidebar.xaml ==================== -->
    <!-- ========================== OreSidebarItem ========================== -->
    <Style TargetType="local:OreSidebarItem">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreSidebarItem">
                    <Border
                        x:Name="OreItemBorder"
                        Height="40"
                        Padding="10,0,0,0"
                        Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="OreItemIcon"
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#FFFFFF"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="OreItemText"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFFFFF"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ OreSidebar ============================ -->
    <!--
        窄屏：遮罩 + 左侧滑出面板（600ms cubic 缓动，对应 sidebar-transition）。
        宽屏（≥1200）：面板常驻、遮罩隐藏，对应 @media (min-width: 1200px)。
    -->
    <Style TargetType="local:OreSidebar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreSidebar">
                    <Grid>
                        <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border
                            x:Name="OreSidebarMask"
                            Background="#000000B3"
                            Visibility="Collapsed" />
                        <Grid
                            x:Name="OreSidebarPanel"
                            Width="238"
                            HorizontalAlignment="Left"
                            Background="#313233"
                            BorderBrush="#1E1E1F"
                            BorderThickness="0,0,2,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="OrePanelTransform" X="-240" />
                            </Grid.RenderTransform>
                            <!--
                                上游 oreui-scroll-view 是 overflow-y: hidden —— 侧边栏压根不显示滚动条。
                                用 Auto 会露出 WinUI 的原生滚动条，整条侧边栏立刻「很 WinUI」。
                                Hidden 仍支持滚轮滚动，只是不画滚动条。
                            -->
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Auto">
                                <StackPanel Margin="0,10">
                                    <TextBlock
                                        x:Name="OreSidebarTitle"
                                        Margin="0,6"
                                        FontFamily="{ThemeResource OreUIFontTitleFamily}"
                                        FontSize="20"
                                        Foreground="#FFFFFF"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        x:Name="OreSidebarDetail"
                                        Margin="0,0,0,24"
                                        FontSize="14"
                                        Foreground="#D0D1D4"
                                        TextAlignment="Center"
                                        Visibility="Collapsed" />
                                    <Border
                                        x:Name="OreSidebarDivider"
                                        Margin="0,0,0,6"
                                        BorderBrush="#313233"
                                        BorderThickness="0,2,0,2" />
                                    <StackPanel x:Name="OreSidebarItems" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
