    <!-- =========================== OreShowBlock =========================== -->
    <!-- 悬停时两道斜白条扫过（thickFlash / thinFlash），由 code-behind 驱动 Storyboard -->
    <Style TargetType="local:OreShowBlock">
        <Setter Property="FontFamily" Value="{ThemeResource OreUIFontBodyFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OreShowBlock">
                    <Grid Margin="6">
                        <Border
                            x:Name="OreShowBlockBorder"
                            Background="Transparent"
                            BorderBrush="#58585A"
                            BorderThickness="2">
                            <Grid>
                                <StackPanel
                                    Margin="17,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <FontIcon
                                            x:Name="OreTitleIcon"
                                            Margin="0,0,5,0"
                                            FontSize="20"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="OreTitleText"
                                            FontSize="17"
                                            Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="OreDescriptionText"
                                        Margin="0,2,0,0"
                                        FontSize="14"
                                        Foreground="#D0D1D4"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <!--
                                    扫光层。三个必须对齐 Web 端的点（见 OreShowBlock.UpdateFlashGeometry）：
                                    1) CSS skewX 绕元素中心，XAML SkewTransform 默认绕 (0,0) => 要设 CenterY=高度/2
                                    2) CSS 的 left 从 -150% 扫到 150%（相对自身宽度），不是固定像素
                                    3) CSS 有 overflow:hidden => 代码里给这一层加 Clip
                                -->
                                <Grid x:Name="OreFlashLayer" IsHitTestVisible="False">
                                    <Rectangle
                                        x:Name="OreFlashThick"
                                        Width="15"
                                        HorizontalAlignment="Left"
                                        Fill="#FFFFFF99">
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform x:Name="OreThickSkew" AngleX="-45" />
                                                <TranslateTransform x:Name="OreThickTransform" X="-400" />
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle
                                        x:Name="OreFlashThin"
                                        Width="6"
                                        HorizontalAlignment="Left"
                                        Fill="#FFFFFF80">
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform x:Name="OreThinSkew" AngleX="-45" />
                                                <TranslateTransform x:Name="OreThinTransform" X="-400" />
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

