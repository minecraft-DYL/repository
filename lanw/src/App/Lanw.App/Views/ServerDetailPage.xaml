<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 返回 + 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Button
                Click="Back_Click"
                Content="返回"
                Style="{StaticResource Action}" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 加载中 -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 错误态（无网络 / 接口异常，不崩溃） -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MaxWidth="640"
            Padding="20"
            Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
            <StackPanel Spacing="10">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="获取服务器详情失败" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Command="{x:Bind ViewModel.LoadCommand}"
                    CommandParameter="{x:Bind ViewModel.ServerId, Mode=OneWay}"
                    Content="重试"
                    Style="{StaticResource Action}" />
            </StackPanel>
        </Border>

        <!-- 详情内容 -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Left"
                MaxWidth="900"
                Spacing="16">

                <!-- 主图 + 小图切换 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Height="329"
                    Width="584">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.MainImage, Mode=OneWay}"
                            Stretch="UniformToFill" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.MainImagePlaceholderVisibility, Mode=OneWay}">
                            <FontIcon
                                FontSize="34"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE7FC;" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="暂无服务器图片" />
                        </StackPanel>
                    </Grid>
                </Border>

                <GridView
                    IsItemClickEnabled="True"
                    ItemClick="Thumbnails_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Images}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.ImagesVisibility, Mode=OneWay}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:ServerImageItemViewModel">
                            <Image
                                Height="48"
                                Source="{x:Bind Image}"
                                Stretch="UniformToFill"
                                Width="80" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 消息/信息列表：服务器 ID / 作者 / 创建时间 / 游戏版本 / 连接地址 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="服务器信息" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器 ID" />
                            <TextBlock
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.ServerId, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器作者" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.AuthorDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="创建时间" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.CreatedAtDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="游戏版本" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.GameVersionDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器地址" />
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AddressDisplay, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.CopyAddressCommand}"
                                Content="复制地址"
                                Style="{StaticResource Action}"
                                Visibility="{x:Bind ViewModel.AddressActionsVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 服务器 MOD：按需求变更，启动游戏不移植，改为说明该服 JAVA 游戏版本与 mod，并可导出 ZIP。
                     本卡片常显（含失败原因）：即使账号未登录/接口失败，也要能看懂「为什么没有 MOD」 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="服务器 MOD" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Java 版本" />
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.JavaVersionDisplay, Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="MOD 版本" />
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.McVersionDisplay, Mode=OneWay}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding SizeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Command="{x:Bind ViewModel.ExportModsZipCommand}"
                            Content="导出 MOD 为 ZIP"
                            Style="{StaticResource Action}" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.ModsSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 服务器介绍 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="服务器介绍" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.FullDescription, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
