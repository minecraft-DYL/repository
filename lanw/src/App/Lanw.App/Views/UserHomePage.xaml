<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.UserHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                HorizontalAlignment="Left"
                MaxWidth="960"
                Spacing="16">

                <!-- 标题 + 退出登录 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="用户中心" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="涅槃账号信息（进程内直调 NirvanaAccountManager.GetLoginInfo，无 HTTP）。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="Logout_Click"
                        Content="退出登录" />
                </Grid>

                <!-- 账号信息卡 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.CardVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="账号信息" />

                        <!-- 隐藏账号（对应 hideAccount 配置） -->
                        <CheckBox
                            Content="隐藏账号"
                            IsChecked="{x:Bind ViewModel.HideAccount, Mode=TwoWay}"
                            ToolTipService.ToolTip="不显示完整账号，重新读取后生效" />

                        <TextBlock
                            FontSize="15"
                            Text="{x:Bind ViewModel.DaysText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="涅槃账号" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="购买更多天数请前往" />
                            <HyperlinkButton
                                Content="涅槃科技"
                                NavigateUri="http://npyyds.top/shop/"
                                Padding="2,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="进行购买" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="关于高级功能"
                                TextDecorations="Underline"
                                ToolTipService.ToolTip="您需要购买天数，才能使用高级功能。" />
                        </StackPanel>

                        <Button
                            Command="{x:Bind ViewModel.ReloadCommand}"
                            Content="重新读取账号信息" />
                    </StackPanel>
                </Border>

                <!-- 未登录占位 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="登录涅槃账号" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="输入涅槃账号与密码登录；登录成功后可在此查看剩余天数。账号没有天数时无法登录。"
                            TextWrapping="Wrap" />

                        <TextBox
                            MaxWidth="360"
                            HorizontalAlignment="Left"
                            Header="账号"
                            PlaceholderText="请输入您的账号"
                            Text="{x:Bind ViewModel.Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox
                            MaxWidth="360"
                            HorizontalAlignment="Left"
                            Header="密码"
                            PlaceholderText="请输入您的密码"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Command="{x:Bind ViewModel.LoginCommand}"
                            Content="登录"
                            Style="{StaticResource PrimaryAction}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton
                                Content="注册账号"
                                NavigateUri="http://npyyds.top/"
                                Padding="2,0" />
                            <HyperlinkButton
                                Content="涅槃商城"
                                NavigateUri="http://npyyds.top/shop"
                                Padding="2,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
