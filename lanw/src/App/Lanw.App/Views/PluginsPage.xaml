<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Lanw.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="36,28"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1180"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <!-- 标题区（对应原 Vue Plugins.vue 的 h1 + 说明） -->
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="插件管理" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="插件管理页面，用于管理系统中的插件。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 工具行：自动更新开关 + 刷新 + 打开商城 -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="16">
                <ToggleSwitch
                    Header="自动更新插件"
                    IsOn="{x:Bind ViewModel.AutoUpdatePlugin, Mode=TwoWay}"
                    OffContent="关闭"
                    OnContent="开启" />
                <Button
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Content="刷新列表"
                    Style="{StaticResource Action}" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="OpenStore_Click"
                    Content="打开插件商城"
                    Style="{StaticResource PrimaryAction}" />
            </StackPanel>

            <!-- 已安装插件列表（名称/版本/作者/状态/操作） -->
            <ListView
                ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PluginItemViewModel">
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Id}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                Text="{x:Bind Version}" />
                            <TextBlock
                                Grid.Column="2"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                Text="{x:Bind Author}" />
                            <TextBlock
                                Grid.Column="3"
                                MinWidth="70"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                            <ToggleSwitch
                                Grid.Column="4"
                                MinWidth="100"
                                IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                OffContent="停用"
                                OnContent="启用"
                                Toggled="PluginToggle_Toggled" />
                            <Button
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Click="DeletePlugin_Click"
                                Content="删除"
                                Style="{StaticResource Action}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空态 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="plugins 目录下暂无已安装插件。可点击「打开插件商城」安装插件。"
                    TextWrapping="Wrap" />
            </Border>

            <!-- 加载状态与提示（对应原 Vue 底部提示「部分插件 可能需要重启，才能彻底生效 !」） -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="部分插件 可能需要重启，才能彻底生效 !"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
