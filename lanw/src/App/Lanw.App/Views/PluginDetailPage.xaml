<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.PluginDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Lanw.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="36,28"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1180"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <!-- 页头：名称 / 插件 ID / Download（对应 Vue plugin-header） -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="16">
                <Button
                    VerticalAlignment="Top"
                    Click="Back_Click"
                    Content="返回" />
                <StackPanel
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PluginId, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Margin="16,0,0,0"
                    VerticalAlignment="Top"
                    Click="Download_Click"
                    Content="{x:Bind ViewModel.InstallButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
                    Style="{StaticResource PrimaryAction}" />
            </StackPanel>

            <!-- 详情内容 -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                <!-- 元信息（发布者/发布时间/插件版本/下载数量） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="发布者" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Publisher, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="发布时间" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.PublishDate, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="插件版本" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="下载数量" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.DownloadCount, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 依赖项（EntityPluginDependency，点击可跳转到依赖插件详情） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="依赖项" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.DependenciesHint, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Dependencies, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:PluginDependencyViewModel">
                                    <Button
                                        Margin="0,0,8,0"
                                        Click="Dependency_Click"
                                        Content="{x:Bind Name}"
                                        Style="{StaticResource Action}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 插件介绍（原 Vue v-html，桌面端以纯文本展示） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="插件介绍" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.DescriptionVisibility, Mode=OneWay}" />
                        <TextBlock
                            FontStyle="Italic"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="这个插件没有介绍自己呢。"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.NoDescriptionVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 错误态（对应 Vue：接口 code != 1 或异常时提示 msg） -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Click="Retry_Click"
                        Content="重试"
                        Style="{StaticResource Action}" />
                </StackPanel>
            </Border>

            <!-- 加载状态 -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
