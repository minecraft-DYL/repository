<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Lanw.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="36,28"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1180"
            HorizontalAlignment="Stretch"
            Spacing="14">

            <!-- 标题区（对应原 Vue PluginStore.vue 的 h1 + 说明） -->
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="插件商城" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="插件商城页面，用于浏览和下载系统中的插件。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 搜索栏（对应 Vue searchQuery：名称/简介/发布者模糊匹配） -->
            <AutoSuggestBox
                MaxWidth="520"
                HorizontalAlignment="Stretch"
                PlaceholderText="搜索插件..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="16">
                <Button
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Content="刷新商城"
                    Style="{StaticResource PrimaryAction}" />
                <Button
                    Click="OpenInstalled_Click"
                    Content="已安装插件"
                    Style="{StaticResource Action}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </StackPanel>

            <!-- 插件卡片列表（名称/简介/发布者/下载次数/安装） -->
            <ListView
                IsItemClickEnabled="True"
                ItemClick="Plugin_ItemClick"
                ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PluginStoreItemViewModel">
                        <Border
                            Margin="0,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ShortDescription}"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="18">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind PublisherText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind DownloadCountText}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind InstallCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="{x:Bind InstallButtonText, Mode=OneWay}"
                                    Style="{StaticResource PrimaryAction}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空态 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="没有可显示的插件。"
                    TextWrapping="Wrap" />
            </Border>

            <!-- 错误态（无网络 / 接口异常，可页内重试） -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="重试"
                        Style="{StaticResource Action}" />
                </StackPanel>
            </Border>

            <!-- 加载更多 -->
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Content="加载更多"
                Style="{StaticResource Action}"
                Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}" />

            <!-- 加载状态 -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
