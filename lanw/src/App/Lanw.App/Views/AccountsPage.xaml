<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 当前账号 + 登录态 + 动作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="账号管理" />
                    <Border
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="4"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LoginStateBadgeVisibility, Mode=OneWay}">
                        <TextBlock
                            FontSize="11"
                            Text="{x:Bind ViewModel.LoginStateText}" />
                    </Border>
                </StackPanel>
                <!-- 注意：XAML 只在整个属性值以 { 开头时才解析绑定；"文字{ x:Bind }" 会被当作字面量原样显示，故拆成两段 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前账号：" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CurrentDisplay, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Click="AddAccount_Click"
                    Content="添加账号"
                    Style="{StaticResource PrimaryAction}" />
                <Button
                    Click="RandomLogin_Click"
                    Content="随机登录" />
                <Button
                    Command="{x:Bind ViewModel.AutoLoginLastActiveCommand}"
                    Content="自动登录" />
                <Button
                    Command="{x:Bind ViewModel.LogoutCommand}"
                    Content="注销" />
                <Button
                    Command="{x:Bind ViewModel.RefreshListCommand}"
                    Content="刷新"
                    Style="{StaticResource Action}" />
            </StackPanel>
        </Grid>

        <!-- 账号列表 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ListView
                ItemsSource="{x:Bind ViewModel.Accounts}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AccountItemViewModel">
                        <Grid Padding="8" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind CurrentBadgeVisibility, Mode=OneWay}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="当前" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind LoginType}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind SafeUserId}"
                                    Visibility="{x:Bind SafeUserIdVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    Command="{x:Bind SwitchCommand}"
                                    Content="切换" />
                                <Button
                                    Command="{x:Bind SetCurrentCommand}"
                                    Content="设为当前" />
                                <Button
                                    Command="{x:Bind EditCommand}"
                                    Content="编辑" />
                                <Button
                                    Command="{x:Bind DeleteCommand}"
                                    Content="删除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态：还没有任何已保存账号 -->
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <TextBlock
                    FontSize="16"
                    HorizontalAlignment="Center"
                    Text="还没有账号，点「添加账号」登录" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="也可以点「随机登录」打开账号池网页端（http://110.42.70.32:23148/nac4399/）获取一个随机 4399 账号，再点「添加账号」加进列表。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 状态条 -->
        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
