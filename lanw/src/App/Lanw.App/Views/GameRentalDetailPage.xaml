<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.GameRentalDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 返回 + 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Button
                Click="Back_Click"
                Content="返回"
                Style="{StaticResource Action}" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 加载中 -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 错误态（无网络 / 接口异常，不崩溃） -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MaxWidth="640"
            Padding="20"
            Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
            <StackPanel Spacing="10">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="获取租赁服详情失败" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Command="{x:Bind ViewModel.LoadCommand}"
                    CommandParameter="{x:Bind ViewModel.ServerId, Mode=OneWay}"
                    Content="重试"
                    Style="{StaticResource Action}" />
            </StackPanel>
        </Border>

        <!-- 详情内容 -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Left"
                MaxWidth="900"
                Spacing="16">

                <!-- 介绍图 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Height="329"
                    Width="584">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.MainImage, Mode=OneWay}"
                            Stretch="UniformToFill" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.MainImagePlaceholderVisibility, Mode=OneWay}">
                            <FontIcon
                                FontSize="34"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE7FC;" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="暂无服务器图片" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 服务器信息（实体 EntityRentalGameDetails） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="服务器信息" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器 ID" />
                            <TextBlock
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.ServerId, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="游戏版本" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器类型" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.ServerTypeDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="在线人数" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.OnlineCountDisplay, Mode=OneWay}" />
                                <TextBlock Text="/" />
                                <TextBlock Text="{x:Bind ViewModel.CapacityDisplay, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 服务器地址（实体 EntityRentalGameServerAddress，含三线接入） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="服务器地址" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="连接地址" />
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AddressDisplay, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.CopyAddressCommand}"
                                Content="复制地址"
                                Style="{StaticResource Action}"
                                Visibility="{x:Bind ViewModel.AddressActionsVisibility, Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器状态" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.AddressStateText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- 多线接入（移动 / 电信 / 联通） -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AddressLines}" Visibility="{x:Bind ViewModel.AddressLinesVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RentalAddressLine">
                                    <Grid ColumnSpacing="16" Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.AddressNote, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 玩家列表（实体 EntityRentalGamePlayerList） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="玩家列表"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.ReloadPlayersCommand}"
                                Content="刷新玩家"
                                Style="{StaticResource Action}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Players}" Visibility="{x:Bind ViewModel.PlayersVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RentalPlayerItemViewModel">
                                    <Grid ColumnSpacing="16" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind UserIdDisplay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind CreatedAtDisplay}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                            <FontIcon
                                                FontSize="9"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Glyph="&#xE73E;"
                                                Visibility="{x:Bind OnlineDotVisibility}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind OnlineText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.PlayersNote, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.PlayersNoteVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 服务器介绍 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="服务器介绍" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.BriefSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
