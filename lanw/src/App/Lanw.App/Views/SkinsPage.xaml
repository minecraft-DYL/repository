<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.SkinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="皮肤管理" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="游戏皮肤列表（数据经 Lanw.Public.SkinMessage / NPFLauncher 皮肤端点进程内直调）。点击卡片查看详情；也可上传本地 PNG 皮肤。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 搜索 + 刷新 + 上传本地皮肤 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="搜索皮肤（名称）…"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.SearchCommand}"
                Content="搜索"
                Style="{StaticResource Action}" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.LoadCommand}"
                Content="刷新"
                Style="{StaticResource Action}" />
            <Button
                Grid.Column="3"
                Click="UploadLocalSkin_Click"
                Content="上传本地皮肤"
                IsEnabled="{x:Bind ViewModel.CanUpload, Mode=OneWay}"
                Style="{StaticResource PrimaryAction}" />
        </Grid>

        <!-- 上传本地皮肤：进行中 / 成功结果 / 失败提示 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind ViewModel.UploadStatusVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsUploading, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.UploadStatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Visibility="{x:Bind ViewModel.UploadErrorVisibility, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind ViewModel.UploadStatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
            <Border
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Visibility="{x:Bind ViewModel.UploadedInfoVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="本地皮肤上传结果（Texture 协议 EntityUserGameTexture）" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.UploadedInfo, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Command="{x:Bind ViewModel.ApplyUploadedCommand}"
                        Content="应用上传的皮肤"
                        Style="{StaticResource Action}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 内容区：列表 / 加载中 / 错误态 / 空态 -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="SkinList"
                IsItemClickEnabled="True"
                ItemClick="SkinList_ItemClick"
                ItemsSource="{x:Bind ViewModel.Skins}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SkinItemViewModel">
                        <Grid Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 皮肤预览图（无图时显示占位图标） -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Height="137"
                                Width="140">
                                <Grid>
                                    <Image
                                        Source="{x:Bind TitleImage}"
                                        Stretch="UniformToFill" />
                                    <FontIcon
                                        FontSize="26"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE790;"
                                        Visibility="{x:Bind PlaceholderVisibility}" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind BriefSummary}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind DeveloperDisplay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind DownloadDisplay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind LikeDisplay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind PublishTimeDisplay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 加载中 -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="22"
                    Height="22"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- 错误态（无网络 / 接口异常，不崩溃） -->
            <Border
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                MaxWidth="640"
                Padding="20"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="皮肤列表加载失败" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="重试"
                        Style="{StaticResource Action}" />
                </StackPanel>
            </Border>

            <!-- 空态 -->
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="6"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <FontIcon
                    FontSize="30"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE790;" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 底部：状态 + 加载更多 -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SearchHintVisibility, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Content="加载更多"
                Style="{StaticResource Action}"
                Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
