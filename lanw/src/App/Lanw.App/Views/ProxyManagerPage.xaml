<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.ProxyManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel
            HorizontalAlignment="Left"
            MaxWidth="1040"
            Spacing="16">

            <TextBlock
                Text="代理管理"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="本机脱盒代理：拦截器在本地监听端口，接管盒子的握手/登录/加密/压缩流程，把白端地址改写到目标服务器；游戏端连接本地地址即可。配置保存在 resources/config.json。"
                TextWrapping="Wrap" />

            <!-- 拦截器配置 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="拦截器配置"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Header="开启脱盒拦截"
                        IsOn="{x:Bind ViewModel.InterceptEnabled, Mode=TwoWay}"
                        OffContent="已关闭（不允许启动新代理）"
                        OnContent="已开启" />

                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Header="代理监听地址（local_address）"
                            Text="{x:Bind ViewModel.LocalAddress, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Header="本地端口（local_port）"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.LocalPort, Mode=TwoWay}" />

                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Header="转发地址（forward_address）"
                            Text="{x:Bind ViewModel.ForwardAddress, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="转发端口（forward_port）"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.ForwardPort, Mode=TwoWay}" />

                        <TextBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Header="游戏昵称（nickname，留空用当前账号昵称）"
                            Text="{x:Bind ViewModel.NickName, Mode=TwoWay}" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Header="服务器名称（server_name）"
                            Text="{x:Bind ViewModel.ServerName, Mode=TwoWay}" />

                        <TextBox
                            Grid.Row="3"
                            Grid.Column="0"
                            Header="服务器版本（server_version）"
                            Text="{x:Bind ViewModel.ServerVersion, Mode=TwoWay}" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Header="游戏 ID（game_id，可留空）"
                            Text="{x:Bind ViewModel.GameId, Mode=TwoWay}" />

                        <TextBox
                            Grid.Row="4"
                            Grid.Column="0"
                            Header="模组信息（mod_info，可留空）"
                            Text="{x:Bind ViewModel.ModInfo, Mode=TwoWay}" />
                        <ToggleSwitch
                            Grid.Row="4"
                            Grid.Column="1"
                            Header="租凭服代理（is_rental）"
                            IsOn="{x:Bind ViewModel.IsRental, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Content="保存配置"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.ReloadCommand}" Content="重新载入" />
                        <Button Command="{x:Bind ViewModel.ResetDefaultsCommand}" Content="恢复默认" />
                        <Button Command="{x:Bind ViewModel.StartInterceptorCommand}" Content="启动本机拦截器" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.CurrentAccountDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.ConfigFilePath}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 运行状态 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="运行状态"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.RefreshListCommand}" Content="刷新" />
                            <Button Command="{x:Bind ViewModel.CloseAllProxiesCommand}" Content="关闭全部代理" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.Proxies}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.HasProxiesVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProxyItemViewModel">
                                <Grid Padding="8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind NickName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind KindDisplay}" />
                                            </Border>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind IdText}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind LocalEndpoint}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ServerName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind ForwardDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind DetailDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind CopyTip, Mode=OneWay}"
                                            Visibility="{x:Bind CopyTipVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button Command="{x:Bind CopyAddressCommand}" Content="复制本地地址" />
                                        <Button Command="{x:Bind CloseCommand}" Content="关闭" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前没有运行的代理服务器。可在上方配置后点击「启动本机拦截器」，或由服务器/租凭服详情页启动代理。"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
