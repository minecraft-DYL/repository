<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel
            HorizontalAlignment="Left"
            MaxWidth="860"
            Spacing="16">
            <TextBlock
                Text="设置"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="本地设置保存在 resources/nirvanaAccount.json，重启后仍然生效。"
                TextWrapping="Wrap" />

            <!-- 自动登录 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="自动登录"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Header="开启主动登录"
                        IsOn="{x:Bind ViewModel.AutoLoginGame, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="开启主动登录 Cookie"
                        IsOn="{x:Bind ViewModel.AutoLoginGameCookie, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="开启主动登录 163Email"
                        IsOn="{x:Bind ViewModel.AutoLoginGame163Email, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Chat | IRC -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Chat | IRC"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Header="是否开启"
                        IsOn="{x:Bind ViewModel.ChatEnable, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 启动配置 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="启动配置"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Header="使用 JavaW（仅 Windows）"
                        IsOn="{x:Bind ViewModel.UseJavaW, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{x:Bind ViewModel.MemoryDisplay, Mode=OneWay}" />
                    <Slider
                        Maximum="18432"
                        Minimum="1024"
                        StepFrequency="512"
                        Value="{x:Bind ViewModel.GameMemory, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="虚拟机参数" />
                    <TextBox
                        AcceptsReturn="True"
                        Height="80"
                        Text="{x:Bind ViewModel.JvmArgs, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="游戏参数" />
                    <TextBox
                        AcceptsReturn="True"
                        Height="60"
                        Text="{x:Bind ViewModel.GameArgs, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 其它配置 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="其它配置"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Header="隐藏账号"
                        IsOn="{x:Bind ViewModel.HideAccount, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="自动更新插件"
                        IsOn="{x:Bind ViewModel.AutoUpdatePlugin, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="界面主题：跟随系统（亮/暗自动适应）" />
                </StackPanel>
            </Border>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="保存设置"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Content="重新载入" />
                <Button
                    Command="{x:Bind ViewModel.ResetToDefaultCommand}"
                    Content="恢复默认" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
