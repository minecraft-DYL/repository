<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.GameLaunchManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="24">
            <StackPanel
                HorizontalAlignment="Left"
                MaxWidth="960"
                Spacing="16">
                <TextBlock
                    Text="启动管理"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="进程内直调启动器：选择游戏版本、设置内存与 JVM 参数后一键启动；下方可查看运行中的游戏实例。参数保存在 resources/nirvanaAccount.json。"
                    TextWrapping="Wrap" />

                <!-- 启动参数 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="启动参数"
                            Style="{StaticResource SubtitleTextBlockStyle}" />

                        <ComboBox
                            DisplayMemberPath="DisplayName"
                            Header="游戏版本"
                            ItemsSource="{x:Bind ViewModel.Versions}"
                            SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}" />

                        <TextBlock Text="当前账号" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="{x:Bind ViewModel.MemoryDisplay, Mode=OneWay}" />
                        <Slider
                            Maximum="18432"
                            Minimum="1024"
                            StepFrequency="512"
                            Value="{x:Bind ViewModel.GameMemory, Mode=TwoWay}" />

                        <TextBlock Margin="0,8,0,0" Text="JVM 参数（虚拟机参数）" />
                        <TextBox
                            AcceptsReturn="True"
                            Height="80"
                            Text="{x:Bind ViewModel.JvmArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="服务器 ID（留空为本地启动）"
                                Text="{x:Bind ViewModel.ServerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="角色名（必填）"
                                Text="{x:Bind ViewModel.RoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="服务器地址（可空）"
                                Text="{x:Bind ViewModel.ServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="服务器端口（可空）"
                                Text="{x:Bind ViewModel.ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <ToggleSwitch
                            Header="安装白端核心模组"
                            IsOn="{x:Bind ViewModel.LoadCoreMods, Mode=TwoWay}" />

                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.LaunchCommand}"
                                Content="启动游戏"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Command="{x:Bind ViewModel.SaveParametersCommand}" Content="保存参数" />
                            <Button Command="{x:Bind ViewModel.RefreshAccountCommand}" Content="刷新账号" />
                        </StackPanel>

                        <ProgressBar
                            Maximum="100"
                            Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 运行中的游戏实例 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="运行中的游戏实例"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.InstanceSummary, Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Command="{x:Bind ViewModel.RefreshInstancesCommand}" Content="刷新列表" />
                            <Button Command="{x:Bind ViewModel.CloseAllCommand}" Content="关闭全部游戏" />
                        </StackPanel>

                        <ListView
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Instances}"
                            Visibility="{x:Bind ViewModel.InstancesVisibility, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RoleName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding GameName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding UserId}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding GameVersion}" />
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="5"
                                            Click="CloseInstance_Click"
                                            Content="关闭" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="当前没有运行的游戏实例"
                            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 启动日志 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="启动日志"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Command="{x:Bind ViewModel.ClearLogCommand}" Content="清空日志" />
                        <ListView
                            Height="220"
                            ItemsSource="{x:Bind ViewModel.LogLines}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Margin="24,0,24,16"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
