<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.GameRentalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="租赁服管理" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="租赁服列表（数据经 Lanw.Public.RentalGameMessage + 租赁服协议进程内直调）。点击卡片查看详情。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 搜索 + 刷新 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="搜索租赁服（名称 / 简介）…"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadCommand}"
                Content="刷新"
                Style="{StaticResource Action}" />
        </Grid>

        <!-- 内容区：列表 / 加载中 / 错误态 / 空态 -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="RentalList"
                IsItemClickEnabled="True"
                ItemClick="RentalList_ItemClick"
                ItemsSource="{x:Bind ViewModel.Servers}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RentalGameItemViewModel">
                        <Grid Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 介绍图（无图时显示占位图标） -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Height="90"
                                Width="160">
                                <Grid>
                                    <Image
                                        Source="{x:Bind TitleImage}"
                                        Stretch="UniformToFill" />
                                    <FontIcon
                                        FontSize="26"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE7FC;"
                                        Visibility="{x:Bind PlaceholderVisibility}" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- 在线状态（EnumServerStatus）：运行中额外显示状态圆点 -->
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon
                                                FontSize="9"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Glyph="&#xE73E;"
                                                Visibility="{x:Bind OnlineDotVisibility}" />
                                            <TextBlock
                                                FontSize="11"
                                                Text="{x:Bind StatusText}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- 可见性（EnumVisibilityStatus） -->
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                        <TextBlock
                                            FontSize="11"
                                            Text="{x:Bind VisibilityText}" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind VersionDisplay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind OnlineCountDisplay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ServerTypeDisplay}" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind BriefSummary}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 加载中 -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="22"
                    Height="22"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在获取租赁服列表…" />
            </StackPanel>

            <!-- 错误态（无网络 / 接口异常，不崩溃） -->
            <Border
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MaxWidth="640"
                Padding="20"
                VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="获取租赁服列表失败" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="重试"
                        Style="{StaticResource Action}" />
                </StackPanel>
            </Border>

            <!-- 空态 -->
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="没有可展示的租赁服"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        </Grid>

        <!-- 状态条 + 加载更多 -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                    VerticalAlignment="Center" />
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Content="加载更多"
                Style="{StaticResource Action}"
                Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
