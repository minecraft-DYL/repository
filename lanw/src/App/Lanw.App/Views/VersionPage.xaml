<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.VersionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                HorizontalAlignment="Left"
                MaxWidth="960"
                Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="版本信息" />

                <!-- 对应原版 others/Version.vue 的提示 -->
                <Border
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12">
                    <TextBlock
                        Text="当前版本可能不包含此内容，请更新至最新版本。"
                        TextWrapping="Wrap" />
                </Border>

                <!-- 当前版本 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="当前版本" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="版本号" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Version, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="版本序号" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                Text="{x:Bind ViewModel.VersionId, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="运行模式" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.Mode, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="系统架构" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                Text="{x:Bind ViewModel.Arch, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="更新器版本" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.UpdateVersion, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="构建类型" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="3"
                                Text="{x:Bind ViewModel.ReleaseText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.LatestText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 检查更新 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="检查更新" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="进程内直读远端更新清单（与启动器 UpdateTools 相同的接口与模式），只读展示：不会下载文件、不会重启进程。"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <Button
                                Command="{x:Bind ViewModel.CheckUpdateCommand}"
                                Content="检查更新"
                                Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Width="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="尚未检查更新"
                            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Results}"
                            Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:UpdateModeResultViewModel">
                                    <Border
                                        Margin="0,6,0,0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                        <StackPanel Spacing="6">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind Mode}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind SuccessText}" />
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Message}"
                                                TextWrapping="Wrap" />

                                            <ItemsControl
                                                ItemsSource="{x:Bind Files}"
                                                Visibility="{x:Bind FilesVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:UpdateFileItemViewModel">
                                                        <Grid ColumnSpacing="10" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                FontFamily="Consolas"
                                                                Text="{x:Bind Path}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind SizeText}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                FontFamily="Consolas"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{x:Bind Sha256Text}" />
                                                            <TextBlock
                                                                Grid.Column="3"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind LocalStateText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="版本检查由 Lanw.Core.LanwProgram 与 Lanw.Public.Entities.Update 提供（进程内直调）。"
            TextWrapping="Wrap" />
    </Grid>
</Page>
