<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.SkinDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lanw.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 返回 + 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Button
                Click="Back_Click"
                Content="返回"
                Style="{StaticResource Action}" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EntityIdText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 加载中 -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 错误态（无网络 / 接口异常，不崩溃） -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MaxWidth="640"
            Padding="20"
            Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
            <StackPanel Spacing="10">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="获取皮肤详情失败" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Command="{x:Bind ViewModel.LoadCommand}"
                    CommandParameter="{x:Bind ViewModel.SkinId, Mode=OneWay}"
                    Content="重试"
                    Style="{StaticResource Action}" />
            </StackPanel>
        </Border>

        <!-- 详情内容 -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Left"
                MaxWidth="900"
                Spacing="16">

                <!-- 大图预览（无图时显示占位图标） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    MaxHeight="420"
                    MaxWidth="584">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.MainImage, Mode=OneWay}"
                            Stretch="Uniform" />
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE790;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- 元信息 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="皮肤作者" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DeveloperName, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="发布时间" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PublishTime, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="下载量" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DownloadNumText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="3"
                            Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="点赞数" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.LikeNumText, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- 皮肤介绍 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="皮肤介绍" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.BriefSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- 应用设置（EntitySkinSettings：skin_type=31 / client_type=java，写入各游戏类型） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="应用设置" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="该功能适用于「启动游戏」启动的白端；应用后会对以下游戏类型统一写入皮肤设置。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.SettingsSummary}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AppliedGameTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Margin="0,2,0,0"
                                        Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Command="{x:Bind ViewModel.ApplyCommand}"
                                Content="使用皮肤"
                                Style="{StaticResource PrimaryAction}" />
                            <ProgressRing
                                Width="18"
                                Height="18"
                                IsActive="{x:Bind ViewModel.IsApplying, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ApplyMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ApplyMessageVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
