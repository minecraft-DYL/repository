<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lanw.App.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Lanw.App.Controls"
    xmlns:vm="using:Lanw.App.ViewModels"
    mc:Ignorable="d">

    <Grid
        Padding="24"
        ColumnSpacing="0"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="用户聊天室" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="IRC 跨服聊天：与其它 lanw 玩家跨服务器聊天，聊天内容按协议版本组包写回游戏客户端。聊天室开关对应全局配置 chatEnable（同时控制游戏内 /irc 指令拦截与心跳）。全部进程内直调，无 HTTP。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 连接与开关 -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="聊天室设置" Style="{StaticResource SubtitleTextBlockStyle}" />

                <ToggleSwitch
                    AutomationProperties.Name="开启聊天室（chatEnable）"
                    Header="开启聊天室（chatEnable）"
                    IsOn="{x:Bind ViewModel.ChatEnabled, Mode=TwoWay}"
                    OffContent="已关闭（游戏内 /irc 指令与心跳停用）"
                    OnContent="已开启" />

                <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="聊天昵称"
                        PlaceholderText="例如：勇敢的末影人"
                        Text="{x:Bind ViewModel.NickName, Mode=TwoWay}" />
                    <TextBox
                        Grid.Column="1"
                        Header="游戏 ID（可留空，缺省 -1）"
                        Text="{x:Bind ViewModel.GameId, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="2"
                        Header="游戏协议版本（决定消息写回游戏端的组包）"
                        SelectedIndex="{x:Bind ViewModel.ProtocolIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="1.8.9" />
                        <ComboBoxItem Content="1.12.2" />
                        <ComboBoxItem Content="1.18.1" />
                        <ComboBoxItem Content="1.20.1" />
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.ConnectCommand}"
                        Content="{x:Bind ViewModel.ConnectButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.DisconnectCommand}" Content="离开聊天室" />
                    <Button Command="{x:Bind ViewModel.UseCurrentAccountCommand}" Content="用当前账号" />
                    <Button Command="{x:Bind ViewModel.ClearMessagesCommand}" Content="清空消息" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.CurrentAccountDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 消息列表 -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
            <ListView
                x:Name="MessageList"
                AutomationProperties.Name="聊天消息列表"
                ItemsSource="{x:Bind ViewModel.Messages}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,3" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                        <Border
                            Background="{x:Bind BubbleBackground}"
                            BorderBrush="{x:Bind BubbleBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="{x:Bind Alignment}"
                            MaxWidth="560"
                            Padding="10,6">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{x:Bind HeaderBrush}"
                                    Text="{x:Bind Header}" />
                                <TextBlock
                                    FontSize="14"
                                    TextWrapping="Wrap"
                                    controls:InlinePartsBinder.Parts="{x:Bind Parts}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 输入 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="ChatInput"
                Grid.Column="0"
                AutomationProperties.Name="聊天输入框"
                KeyDown="ChatInput_KeyDown"
                PlaceholderText="输入聊天内容后回车或点「发送」（支持 §x 颜色码，如 §c红色§r）"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.SendCommand}"
                Content="发送"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
