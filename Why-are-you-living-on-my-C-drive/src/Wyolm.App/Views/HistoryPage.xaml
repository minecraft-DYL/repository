<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wyolm.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Wyolm.App.Services"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="历史与恢复" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="每一次搬迁都记在这里。应用每次启动时会检查是否有上次被强行中断的作业，并自动把它收尾或回滚 —— 结果也会显示在下面。" />
        </StackPanel>

        <!--  启动恢复  -->
        <Border x:Name="RecoveryPanel" Grid.Row="1" Padding="14" CornerRadius="8"
                Visibility="Collapsed"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="启动时的崩溃恢复" FontWeight="SemiBold" />
                <TextBlock x:Name="RecoverySummaryText" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                <ItemsControl x:Name="RecoveryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  工具栏  -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="刷新" Click="Refresh_Click" />
            <Button Content="打开日志文件夹" Click="OpenLogs_Click" />
            <Button Content="打开数据目录" Click="OpenData_Click" />
            <Button Content="清空历史记录" Click="ClearHistory_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="" />
        </StackPanel>

        <!--  表头  -->
        <Grid Grid.Row="3" Padding="12,0,12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="时间" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="操作" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="2" Text="结果" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="3" Text="源 → 目标" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="4" Text="数据量" FontSize="12" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right" />
        </Grid>

        <ListView x:Name="HistoryList" Grid.Row="4"
                  SelectionMode="Single"
                  BorderThickness="1" CornerRadius="8"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:HistoryRow">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind Time}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Mode}" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Outcome}" FontSize="12" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="3" Spacing="1">
                            <TextBlock Text="{x:Bind Source}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Destination}" FontSize="11" Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="4" Text="{x:Bind Size}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  说明  -->
        <TextBlock Grid.Row="5" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                   Text="日志与历史保存在 %LOCALAPPDATA%\Wyolm 下。如果某次搬迁失败并且「回滚未完成」，请先不要删除任何文件，把日志发出来一起看。" />
    </Grid>
</Page>
