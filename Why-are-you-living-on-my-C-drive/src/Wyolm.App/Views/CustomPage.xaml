<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wyolm.App.Views.CustomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="12">

            <StackPanel Spacing="2">
                <TextBlock Text="自定义迁移" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Text="把任意一个文件夹搬到任意位置，或者只复制、只建链接。搬家模式下，目标副本校验通过后才会动原目录；原位置建链接失败会自动把原目录还原。" />
            </StackPanel>

            <!--  路径  -->
            <Border Padding="14" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="1 · 从哪搬到哪" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="源文件夹" VerticalAlignment="Center" />
                        <TextBox x:Name="SourceBox" Grid.Column="1" PlaceholderText="要被搬走的文件夹" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseSource_Click" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="目标位置" VerticalAlignment="Center" />
                        <TextBox x:Name="DestinationBox" Grid.Column="1"
                                 PlaceholderText="数据要落到哪（含文件夹名），或在「只建链接」模式下填真实数据所在处" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseDestination_Click" />
                        <Button Grid.Column="3" Content="用源文件夹名自动补全" Click="AutoFillDestination_Click" />
                    </Grid>

                    <TextBlock x:Name="PathHintText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="" />
                </StackPanel>
            </Border>

            <!--  选项  -->
            <Border Padding="14" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="2 · 怎么搬" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="操作" FontSize="12" Opacity="0.75" />
                            <ComboBox x:Name="ModeBox" Width="280" SelectedIndex="0"
                                      SelectionChanged="ModeBox_SelectionChanged">
                                <ComboBoxItem Content="搬家 + 原位建链接（推荐）" />
                                <ComboBoxItem Content="只复制（原文件夹保留）" />
                                <ComboBoxItem Content="只建链接（数据已在别处）" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="链接类型" FontSize="12" Opacity="0.75" />
                            <ComboBox x:Name="LinkKindBox" Width="210" SelectedIndex="0">
                                <ComboBoxItem Content="目录联接（推荐·免管理员）" />
                                <ComboBoxItem Content="目录符号链接" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="校验强度" FontSize="12" Opacity="0.75" />
                            <ComboBox x:Name="VerifyLevelBox" Width="240" SelectedIndex="1">
                                <ComboBoxItem Content="结构 + 大小 + 时间戳（推荐）" />
                                <ComboBoxItem Content="结构 + 大小 + SHA-256 全量哈希" />
                                <ComboBoxItem Content="只看结构（最快）" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <ToggleSwitch x:Name="DryRunSwitch" OffContent="真实执行" OnContent="只检查不动手" />
                        <ToggleSwitch x:Name="KeepBackupSwitch" OffContent="删除原盘旧数据" OnContent="保留原盘旧数据" />
                        <ToggleSwitch x:Name="MergeSwitch" OffContent="目标必须为空" OnContent="允许合并进已有目录" />
                        <ToggleSwitch x:Name="SkipLockCheckSwitch" OffContent="检查文件占用" OnContent="跳过占用检查" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  操作  -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="CheckButton" Content="先检查一下（不改任何东西）"
                        Click="Check_Click" />
                <Button x:Name="RunButton" Content="执行"
                        Click="Run_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" />
            </StackPanel>

            <!--  进度  -->
            <StackPanel x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="ProgressPhaseText" FontWeight="SemiBold" Text="准备中…" />
                <ProgressBar x:Name="ProgressBarControl" Maximum="100" Value="0" />
                <TextBlock x:Name="ProgressDetailText" FontSize="12" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" Text="" />
            </StackPanel>

            <!--  检查清单  -->
            <Border x:Name="ChecksPanel" Padding="14" CornerRadius="8" Visibility="Collapsed"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="前置检查结果" FontWeight="SemiBold" />
                    <ItemsControl x:Name="ChecksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  结果  -->
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
            <ScrollViewer x:Name="ResultNotesScroller" MaxHeight="160" Visibility="Collapsed">
                <TextBlock x:Name="ResultNotesText" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>

        </StackPanel>
    </ScrollViewer>
</Page>
