<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wyolm.App.Views.ReconnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Wyolm.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="接回原位" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="扫描任意盘符，找出被 Wyolm 搬走的文件夹（它们里面留有 .wyolm-origin.json 标记），然后把目录联接接回 C 盘原位置。也可以手动指定：东西是你自己搬到别的盘的，同样能接回来。" />
        </StackPanel>

        <!--  自动扫描  -->
        <Border Grid.Row="1" Padding="14" CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="1 · 在哪个盘里找" FontWeight="SemiBold" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="盘符" VerticalAlignment="Center" />
                    <ComboBox x:Name="ScanDriveBox" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Display"
                              PlaceholderText="选择盘符"
                              SelectionChanged="ScanDriveBox_SelectionChanged" />

                    <TextBox x:Name="ScanRootBox" Grid.Column="2" PlaceholderText="要查找的目录" />

                    <Button Grid.Column="3" Content="浏览…" Click="BrowseScanRoot_Click" />

                    <TextBlock Grid.Column="4" Text="深度" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <NumberBox x:Name="MaxDepthBox" Grid.Column="5" Width="90"
                               Value="5" Minimum="1" Maximum="12" SpinButtonPlacementMode="Compact" />

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FindButton" Content="查找可接回的文件夹"
                                Click="Find_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelFindButton" Content="取消"
                                Click="CancelFind_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="FindStatusText" FontSize="12" Opacity="0.7" Text="" />
            </StackPanel>
        </Border>

        <!--  列表表头  -->
        <Grid Grid.Row="2" Padding="12,0,12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="现在的真实位置" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="要接回的原位置" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="2" Text="状态" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
        </Grid>

        <ListView x:Name="CandidateList" Grid.Row="3"
                  SelectionMode="Extended"
                  SelectionChanged="CandidateList_SelectionChanged"
                  BorderThickness="1" CornerRadius="8"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ScanItem">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind FullPath}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{x:Bind OriginalPath}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.85" />

                        <TextBlock Grid.Column="2" Text="{x:Bind Suggestion}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  进度  -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="ProgressPhaseText" FontWeight="SemiBold" Text="准备中…" />
            <ProgressBar x:Name="ProgressBarControl" IsIndeterminate="True" />
            <TextBlock x:Name="ProgressDetailText" FontSize="12" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" Text="" />
        </StackPanel>

        <!--  手动接回  -->
        <Border Grid.Row="5" Padding="14" CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="2 · 手动接回（适用于自己搬走的文件夹，或没扫描到的情况）" FontWeight="SemiBold" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="真实位置" VerticalAlignment="Center" />
                    <TextBox x:Name="ManualRealPathBox" Grid.Column="1"
                             PlaceholderText="文件夹现在实际在哪，例如 D:\WyolmMoved\某某" />
                    <Button Grid.Column="2" Content="浏览…" Click="BrowseManualReal_Click" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="原位置" VerticalAlignment="Center" />
                    <TextBox x:Name="ManualOriginalPathBox" Grid.Column="1"
                             PlaceholderText="链接应该出现在哪，例如 C:\Users\你\某某" />
                    <Button Grid.Column="2" Content="浏览…" Click="BrowseManualOriginal_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ManualLinkButton" Content="在这个位置建立链接"
                            Click="ManualLink_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="ManualHintText" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.7"
                               Text="原位置必须不存在，或者是一个空文件夹。" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  结果  -->
        <StackPanel Grid.Row="6" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReconnectButton" Content="接回选中的文件夹"
                        IsEnabled="False" Click="Reconnect_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Text="尚未选中任何文件夹" />
            </StackPanel>

            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
            <ScrollViewer x:Name="ResultNotesScroller" MaxHeight="120" Visibility="Collapsed">
                <TextBlock x:Name="ResultNotesText" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
