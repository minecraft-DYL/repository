<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wyolm.App.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Wyolm.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="扫描与搬家" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="挑一个盘，看看什么东西占了地方。选中要搬走的文件夹，Wyolm 会把它们复制到目标盘、逐字节校验、然后在原位置留下一个目录联接 —— 任何一步出错都会自动回滚，原文件夹不会有事。" />
        </StackPanel>

        <!--  扫描范围  -->
        <Border Grid.Row="1" Padding="14" CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="1 · 扫描范围" FontWeight="SemiBold" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="盘符" VerticalAlignment="Center" />
                    <ComboBox x:Name="SourceDriveBox" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Display"
                              PlaceholderText="选择盘符"
                              SelectionChanged="SourceDriveBox_SelectionChanged" />

                    <TextBox x:Name="SourcePathBox" Grid.Column="2"
                             PlaceholderText="要扫描的目录，例如 C:\Users\你" />

                    <Button x:Name="BrowseSourceButton" Grid.Column="3"
                            Content="浏览…" Click="BrowseSource_Click" />
                    <Button x:Name="ScanButton" Grid.Column="4"
                            Content="开始扫描" Click="Scan_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="CancelScanButton" Grid.Column="5"
                            Content="取消" Click="CancelScan_Click" IsEnabled="False" />
                </Grid>

                <TextBlock x:Name="ScanStatusText" Opacity="0.7" FontSize="12" Text="" />
            </StackPanel>
        </Border>

        <!--  目标与选项  -->
        <Border Grid.Row="2" Padding="14" CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="2 · 搬到哪儿" FontWeight="SemiBold" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="目标盘" VerticalAlignment="Center" />
                    <ComboBox x:Name="TargetDriveBox" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Display"
                              PlaceholderText="选择盘符"
                              SelectionChanged="TargetDriveBox_SelectionChanged" />

                    <TextBlock Grid.Column="2" Text="子目录" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox x:Name="TargetSubFolderBox" Grid.Column="3"
                             Text="WyolmMoved"
                             PlaceholderText="例如 WyolmMoved" />

                    <TextBlock x:Name="DestinationPreviewText" Grid.Column="4"
                               VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Text="未选择目标盘" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="链接类型" FontSize="12" Opacity="0.75" />
                        <ComboBox x:Name="LinkKindBox" Width="200" SelectedIndex="0">
                            <ComboBoxItem Content="目录联接（推荐·免管理员）" />
                            <ComboBoxItem Content="目录符号链接" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="校验强度" FontSize="12" Opacity="0.75" />
                        <ComboBox x:Name="VerifyLevelBox" Width="230" SelectedIndex="1">
                            <ComboBoxItem Content="结构 + 大小 + 时间戳（推荐）" />
                            <ComboBoxItem Content="结构 + 大小 + SHA-256 全量哈希" />
                            <ComboBoxItem Content="只看结构（最快）" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="完成后" FontSize="12" Opacity="0.75" />
                        <ToggleSwitch x:Name="KeepBackupSwitch" OnContent="保留原盘旧数据" OffContent="删除原盘旧数据" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="试运行" FontSize="12" Opacity="0.75" />
                        <ToggleSwitch x:Name="DryRunSwitch" OnContent="只检查不动手" OffContent="真实执行" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MigrateButton"
                            Content="开始搬家"
                            IsEnabled="False"
                            Click="Migrate_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="SelectionText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Opacity="0.7"
                               Text="尚未选中任何文件夹" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  列表表头  -->
        <Grid Grid.Row="3" Padding="12,0,12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="文件夹" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="占用" FontSize="12" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="类型" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="3" Text="提示" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
        </Grid>

        <!--  列表  -->
        <ListView x:Name="ItemList" Grid.Row="4"
                  SelectionMode="Extended"
                  SelectionChanged="ItemList_SelectionChanged"
                  BorderThickness="1" CornerRadius="8"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ScanItem">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind FullPath}" FontSize="11" Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{x:Bind KindDisplay}"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.8" />

                        <TextBlock Grid.Column="3" Text="{x:Bind Suggestion}"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  进度  -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="5" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="ProgressPhaseText" FontWeight="SemiBold" Text="准备中…" />
            <ProgressBar x:Name="ProgressBarControl" Maximum="100" Value="0" />
            <TextBlock x:Name="ProgressDetailText" FontSize="12" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" Text="" />
        </StackPanel>

        <!--  结果  -->
        <StackPanel Grid.Row="6" Spacing="8">
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
            <ScrollViewer x:Name="ResultNotesScroller" MaxHeight="120" Visibility="Collapsed">
                <TextBlock x:Name="ResultNotesText" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
