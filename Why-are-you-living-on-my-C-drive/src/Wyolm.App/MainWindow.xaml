<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wyolm.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Wyolm — 别住在我的 C 盘上">

    <NavigationView x:Name="Nav"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    OpenPaneLength="240"
                    SelectionChanged="Nav_SelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Margin="4,12,4,12" Spacing="2">
                <TextBlock Text="Wyolm" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="别住在我的 C 盘上"
                           FontSize="12"
                           Opacity="0.65" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="扫描与搬家" Tag="scan">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Find" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="接回原位" Tag="reconnect">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Link" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="自定义迁移" Tag="custom">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="MoveToFolder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="历史与恢复" Tag="history">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Repair" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <Border Margin="12,8,12,12" Padding="10,8" CornerRadius="6"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <TextBlock x:Name="CapabilityText"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Text="正在检测链接能力…" />
            </Border>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
